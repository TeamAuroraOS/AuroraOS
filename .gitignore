build/
output/
mockup/

# Dumped copyright material (NWM Wi-Fi sysmodule + extracted Atheros firmware).
# Must NOT be committed; users dump these from their own console.
exclude/
# The aShop demo's "Better on New 3DS" banner shows Nintendo's logo and
# console photo; it stays local like the rest of that material.
Aurora/Store/new3ds.png
*.bin
*.elf
*.firm
*.o
*.a
*.map
*.lst

# Exception: the built apps under Games/ are shipped with the repository, so
# they are re-included after the blanket *.bin rule above. Both spellings are
# listed because pattern matching is case-sensitive where core.ignoreCase is
# not set (Linux, macOS).
!Games/**/*.bin
!Games/**/*.BIN

__pycache__/
*.pyc

.vscode/
.vs/
.idea/
.DS_Store
Thumbs.db

# Songs as they were delivered: the build reads the WAVs made from them
# (docs/assets.md "Sounds").
assets/audio/*.m4a

*.log
*.tmp
*.swp
*.swo

desktop.ini

# Local briefing, kept off GitHub
CONTEXT.md
